---
interface Props {
  heading: string;
  subheading?: string;
}

const { heading, subheading = 'Operate tunnel clients with fast, minimal overhead workflows.' } = Astro.props;
---

<div class="h-screen overflow-hidden bg-[radial-gradient(circle_at_top_left,#f7fee7_0%,#ffffff_38%)] dark:bg-[radial-gradient(circle_at_top_left,#1a2b0f_0%,#020617_40%)]">
  <div class="relative grid h-full grid-cols-1 md:grid-cols-[260px_minmax(0,1fr)]">
    <aside
      id="app-sidebar"
      class="fixed inset-y-0 left-0 z-40 w-[84%] max-w-[260px] -translate-x-full border-r border-slate-200/80 bg-white/90 p-3 backdrop-blur-xl transition-all duration-200 ease-in-out md:static md:w-auto md:max-w-none md:translate-x-0 dark:border-slate-800 dark:bg-slate-950/85"
    >
      <a href="/" class="mb-4 inline-flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-semibold text-ink dark:text-slate-100">
        <span class="inline-grid h-7 w-7 place-items-center rounded-md bg-lime-500 text-xs font-bold text-white">K</span>
        Kanara Tunnel Manager
      </a>
      <nav class="space-y-1 text-sm">
        <a class="block rounded-lg px-3 py-2 text-slate-700 transition-all duration-200 ease-in-out hover:bg-lime-50 hover:text-lime-700 dark:text-slate-300 dark:hover:bg-lime-950/40 dark:hover:text-lime-300" href="/">Dashboard</a>
        <a class="block rounded-lg px-3 py-2 text-slate-700 transition-all duration-200 ease-in-out hover:bg-lime-50 hover:text-lime-700 dark:text-slate-300 dark:hover:bg-lime-950/40 dark:hover:text-lime-300" href="/clients">Clients</a>
        <a id="admin-nav-link" class="hidden rounded-lg px-3 py-2 text-slate-700 transition-all duration-200 ease-in-out hover:bg-lime-50 hover:text-lime-700 dark:text-slate-300 dark:hover:bg-lime-950/40 dark:hover:text-lime-300" href="/admin">Admin</a>
        <a class="block rounded-lg px-3 py-2 text-slate-700 transition-all duration-200 ease-in-out hover:bg-lime-50 hover:text-lime-700 dark:text-slate-300 dark:hover:bg-lime-950/40 dark:hover:text-lime-300" href="/profile">Profile</a>
      </nav>
      <a class="mt-4 inline-flex w-full items-center justify-center rounded-lg bg-lime-500 px-3 py-2 text-sm font-medium text-white transition-all duration-200 ease-in-out hover:bg-lime-600" href="/logout">Logout</a>
    </aside>

    <button
      id="sidebar-overlay"
      aria-label="Close sidebar"
      class="fixed inset-0 z-30 hidden bg-slate-900/30 backdrop-blur-sm md:hidden"
    ></button>

    <div class="min-w-0 overflow-y-auto">
      <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-950/70">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
          <button
            id="sidebar-toggle"
            aria-label="Toggle sidebar"
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition-all duration-200 ease-in-out hover:border-lime-300 hover:text-lime-700 md:hidden dark:border-slate-700 dark:text-slate-300 dark:hover:border-lime-500 dark:hover:text-lime-300"
          >
            ≡
          </button>
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Control Panel</p>
        </div>
      </header>

      <main class="mx-auto max-w-6xl px-4 pb-10 pt-6">
        <section class="mb-5 rounded-2xl border border-slate-200/80 bg-white/90 p-5 shadow-[0_1px_2px_rgba(16,24,40,0.06),0_8px_24px_rgba(16,24,40,0.05)] dark:border-slate-800 dark:bg-slate-950/80">
          <h1 class="text-2xl font-semibold tracking-[-0.02em] text-slate-900 dark:text-slate-100">{heading}</h1>
          <p class="mt-1.5 max-w-2xl text-sm text-slate-600 dark:text-slate-400">{subheading}</p>
        </section>
        <slot />
      </main>
    </div>
  </div>
</div>

<script>
  const adminLink = document.getElementById('admin-nav-link');
  const toggleButton = document.getElementById('sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');
  const sidebar = document.getElementById('app-sidebar');

  function setSidebar(open: boolean) {
    if (!sidebar || !overlay) return;
    sidebar.classList.toggle('-translate-x-full', !open);
    overlay.classList.toggle('hidden', !open);
  }

  toggleButton?.addEventListener('click', () => setSidebar(true));
  overlay?.addEventListener('click', () => setSidebar(false));

  fetch('/api/me', { credentials: 'same-origin' })
    .then((response) => (response.ok ? response.json() : null))
    .then((me) => {
      if (me?.role === 'admin') {
        adminLink?.classList.remove('hidden');
      }
    })
    .catch(() => {
      // Keep nav stable for non-authenticated error states.
    });
</script>
