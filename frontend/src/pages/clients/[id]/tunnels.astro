---
import { Theme } from '@radix-ui/themes';
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ClientTunnelManager from '../../../components/dashboard/ClientTunnelManager';

export function getStaticPaths() {
  // Since we are likely using SSR or a fallback, we might not know all IDs at build time.
  // But Astro with static output needs this. If it's SSR, we use another approach.
  // For now, let's assume we want to handle this client-side or we have a limited set.
  return [
    { params: { id: 'placeholder' } }
  ];
}

const { id } = Astro.params;
---

<DashboardLayout title={`Manage Tunnels | ${id}`} heading="Manage Tunnels" subheading={`Configure port forwarding for client: ${id}`}>
  <Theme accentColor="lime" grayColor="sand" radius="large" scaling="100%">
    <ClientTunnelManager client:load clientId={id} />
  </Theme>
</DashboardLayout>
