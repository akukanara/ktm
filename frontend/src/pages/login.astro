---
import { Theme, Card, Text, Button, TextField } from '@radix-ui/themes';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Login | KTM">
  <Theme accentColor="lime" grayColor="sand" radius="large" scaling="100%">
    <div class="grid min-h-screen place-items-center bg-[radial-gradient(circle_at_top,#ecfccb,transparent_45%),linear-gradient(180deg,#fff,#f8fafc)] px-4">
      <Card className="w-full max-w-md border border-lime-100 p-7 shadow-soft">
        <div class="mb-6 text-center">
          <span class="mx-auto mb-3 inline-grid h-11 w-11 place-items-center rounded-xl bg-lime-500 text-lg font-semibold text-white">K</span>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-lime-700">Kanara Tunnel Manager</p>
          <h1 class="mt-2 text-2xl font-semibold text-slate-900">Welcome back</h1>
          <p class="mt-1 text-sm text-slate-600">Sign in to manage clients, proxies, and install scripts.</p>
        </div>

        <form method="POST" action="/login" class="space-y-4">
          <label class="block">
            <Text as="p" size="2" className="mb-1">Username or Email</Text>
            <TextField.Root name="username" required placeholder="you@example.com" />
          </label>
          <label class="block">
            <Text as="p" size="2" className="mb-1">Password</Text>
            <TextField.Root type="password" name="password" required placeholder="••••••••" />
          </label>
          <Button type="submit" size="3" className="w-full">Sign In</Button>
        </form>
      </Card>
    </div>
  </Theme>
</BaseLayout>
