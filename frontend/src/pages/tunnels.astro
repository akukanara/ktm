---
import { Theme } from '@radix-ui/themes';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TunnelCards from '../components/dashboard/TunnelCards';
---

<DashboardLayout title="Tunnels | KTM" heading="Tunnels" subheading="Monitor and manage all active port-forwarding tunnels across your network.">
  <Theme accentColor="lime" grayColor="sand" radius="large" scaling="100%">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold text-slate-800">All Active Tunnels</h2>
    </div>

    <TunnelCards client:load />
  </Theme>
</DashboardLayout>
